{
  "name": "netauratech/theme-manager",
  "description": "Gère les thèmes de l'administration du CMS.",
  "require": {
    "php": "^8.1",
    "netauratech/core-cms": "*"
  },
  "autoload": {
    "psr-4": {
      "NetAuraTech\\ThemeManager\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "NetAuraTech\\ThemeManager\\ThemeManagerServiceProvider"
      ]
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core-cms"
    }
  ]
}