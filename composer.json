{
  "name": "netauratech/theme-manager",
  "description": "Manages CMS themes.",
  "require": {
    "php": "^8.1",
    "ext-zip": "*",
    "netauratech/core-cms": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Netauratech\\ThemeManager\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Netauratech\\ThemeManager\\ThemeManagerServiceProvider"
      ]
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:NetAuraTech/core-cms.git"
    }
  ]
}
